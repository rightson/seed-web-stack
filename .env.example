# =============================================================================
# DATABASE
# =============================================================================

# PostgreSQL (Recommended)
DATABASE_URL="postgresql://postgres:mypassword@localhost:5432/myapp"

# SQLite (Alternative - simpler, no DB server)
# DATABASE_URL="file:./dev.db"

# PostgreSQL Examples:
# - Local: postgresql://postgres:password@localhost:5432/dbname
# - Supabase: postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
# - Railway: postgresql://postgres:[PASSWORD]@[HOST].railway.app:5432/railway
# - With SSL: postgresql://user:pass@host:5432/db?sslmode=require
# - With pooling: postgresql://user:pass@host:5432/db?connection_limit=10

# =============================================================================
# AUTHENTICATION
# =============================================================================

# JWT Secret - CHANGE THIS IN PRODUCTION!
# Generate: openssl rand -base64 32
JWT_SECRET="your-secret-key-change-in-production"

# =============================================================================
# APPLICATION (Optional)
# =============================================================================

# Node environment (auto-detected in development)
# NODE_ENV="development"
